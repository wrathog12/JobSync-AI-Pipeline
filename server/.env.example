# Copy to `server/.env` (gitignored) and fill in. Nothing here is required for the
# test suite — it is hermetic — only for actually calling Gemini.

# From aistudio.google.com/apikey. Single line, starts "AIza".
GEMINI_API_KEY=

# Leave false. Setting it true refuses to fall back to the key above, which is
# only what you want if you are serving other people and they supply their own.
REQUIRE_USER_KEY=false

# Fast tier does the structuring, tagging, and most generation.
LLM_MODEL_FAST=gemini-2.5-flash
LLM_MODEL_STRONG=gemini-2.5-pro

# Ceiling per response. A résumé's worth of structured JSON needs room; prose
# answers need much less.
LLM_MAX_OUTPUT_TOKENS=2048

# 0 disables thinking on 2.5 Flash. Extraction is not reasoning, and thinking
# tokens are billed as output while never appearing in the response.
THINKING_BUDGET_FAST=0

# One SQLite file, relative to wherever you start uvicorn. Created on first run,
# along with its parent directory. Delete the file to start over.
#   :memory:  a fresh database per process — nothing survives a restart
#   (empty)   storage off entirely; the server says so on startup
DB_PATH=data/jobsync.db
