{
  "manifest_version": 3,
  "name": "JobSync",
  "version": "0.1.0",
  "description": "Reads a job application form, answers it from your confirmed memory, and refuses to answer for you where it shouldn't.",
  "minimum_chrome_version": "116",

  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],

  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*"
  ],

  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },

  "action": {
    "default_popup": "src/popup.html",
    "default_title": "JobSync"
  }
}
